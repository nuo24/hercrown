{
  "name": "bible-scroll-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "check": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "deploy:staging": "wrangler deploy --env staging",
    "build:kjv": "node scripts/build-kjv.mjs",
    "seed:kjv": "wrangler d1 execute DB --local --file seeds/kjv.sql",
    "seed:kjv:staging": "wrangler d1 execute DB --env staging --remote --file seeds/kjv.sql",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote"
  },
  "dependencies": {
    "better-auth": "^1.7.15"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.2"
  }
}
