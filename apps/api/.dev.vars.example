# Copy to .dev.vars (gitignored) for local dev. Use TEST values only.
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# Sign in with Apple (leave APPLE_CLIENT_ID empty to disable Apple locally)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Online translations via API.Bible (leave empty to serve KJV only)
API_BIBLE_KEY=
# Superwall webhook signing secret (whsec_...)
SUPERWALL_WEBHOOK_SECRET=
