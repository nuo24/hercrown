# Copy to .dev.vars (gitignored) for local dev. Use TEST values only.
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# Sign in with Apple (leave APPLE_CLIENT_ID empty to disable Apple locally)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Online translations via API.Bible (leave empty to serve KJV only)
API_BIBLE_KEY=
# Superwall webhook signing secret (whsec_...)
SUPERWALL_WEBHOOK_SECRET=
# App Store Server API (Restore Purchases): App Store Connect > Users and Access > Integrations > In-App Purchase key
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
# Contents of the .p8 file; newlines may be written as \n
APP_STORE_PRIVATE_KEY=
# Tinybird Events API write-only token (scope DATASOURCES:APPEND on "events"); empty = events are logged, not sent
TINYBIRD_TOKEN=
# OpenRouter key for AI study tools (staging/production: wrangler secret put OPENROUTER_API_KEY)
OPENROUTER_API_KEY=
